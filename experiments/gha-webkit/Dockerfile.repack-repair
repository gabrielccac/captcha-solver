FROM ${RAW_REPACK}
USER 0:0
COPY --from=original /etc/ssl/certs/ /etc/ssl/certs/
COPY --from=original /usr/share/ca-certificates/ /usr/share/ca-certificates/
RUN rm -- /etc/ssl/certs/NetLock_Arany_=Class_Gold=_Ftanstvny.pem /usr/share/ca-certificates/mozilla/NetLock_Arany_=Class_Gold=_Ftanstvny.crt
